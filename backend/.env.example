# Environment variables for TheFrontDesk Backend

# Server
NODE_ENV=development
PORT=3000

# Frontend URL
FRONTEND_URL=http://localhost:3001

# JWT
JWT_SECRET=your_very_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/thefrontdesk
DB_NAME=thefrontdesk

# Airtel Money API
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_API_SECRET=your_airtel_api_secret
AIRTEL_MERCHANT_ID=your_merchant_id
AIRTEL_PHONE_NUMBER=+254781306215

# Email Service (SendGrid/Gmail)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=hubdarkest@gmail.com

# WhatsApp Business API
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_PHONE_NUMBER=+254714810214

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_GROUP_ID=your_telegram_group_id

# AWS S3 (for photo uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=thefrontdesk-photos
AWS_REGION=us-east-1

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100